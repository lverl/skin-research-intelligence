DATABASE_URL=postgresql://skin:change-me@localhost:5432/skin_research
# Coolify generates SERVICE_PASSWORD_* automatically. Plain local Compose needs values here.
SERVICE_PASSWORD_POSTGRES=
# Only needed if optional docker-compose.web.yml is enabled.
SERVICE_PASSWORD_APP=
SERVICE_PASSWORD_ADMIN=
OPENROUTER_API_KEY=
# Choose a model supporting JSON output. No paid calls until configured.
MODEL=
# Set USD allowance after reserving infrastructure/search costs within 5000 RUB/month.
MODEL_MONTHLY_USD=0
# Conservative reservation per request, not a guaranteed provider price cap.
MODEL_CALL_RESERVE_USD=1
# Exa is optional; direct sources work without these settings. All USD caps are
# shared by questions/daily discovery: <=5/month, <=0.05/whole research scope.
EXA_API_KEY=
EXA_MONTHLY_USD=0
EXA_SCOPE_USD=0
# Fail closed until operator confirms current official pricing in Coolify.
# https://exa.ai/docs/reference/pricing reviewed 2026-11-08:
# fixed auto Search <=5 results costs 0.007; text-only Contents <=3 pages 0.003.
# Upper bounds cover WHOLE calls, not per page; defaults send no paid requests.
# EXA_PRICING_DATE must equal the code's reviewed date, valid for 31 days.
EXA_PRICING_DATE=
EXA_SEARCH_UPPER_USD=0
EXA_CONTENTS_UPPER_USD=0
EXA_MAX_RESULTS=5
EXA_MAX_CONTENTS=3
# Used only for direct Python launch; Compose maps generated passwords to these names.
APP_TOKEN=
ADMIN_TOKEN=
PORT=8000
DIGEST_TIMEZONE=Europe/Moscow
DIGEST_HOUR=19
TELEGRAM_TOKEN=
# Ask your bot /id, then add that private chat ID here. Comma-separated for friends.
TELEGRAM_CHAT_IDS=
# Numeric Telegram ID allowed to use the Mini App during the owner-only phase.
OWNER_TELEGRAM_ID=
# Override the Coolify-generated Mini App URL only when needed.
WEBAPP_URL=
