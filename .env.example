DATABASE_URL=postgresql://skin:change-me@localhost:5432/skin_research
# Coolify generates SERVICE_PASSWORD_* automatically. Plain local Compose needs values here.
SERVICE_PASSWORD_POSTGRES=
# Only needed if optional docker-compose.web.yml is enabled.
SERVICE_PASSWORD_APP=
SERVICE_PASSWORD_ADMIN=
OPENROUTER_API_KEY=
# Choose a model supporting JSON output. No paid calls until configured.
MODEL=
# Set USD allowance after reserving infrastructure/search costs within 5000 RUB/month.
MODEL_MONTHLY_USD=0
# Conservative reservation per request, not a guaranteed provider price cap.
MODEL_CALL_RESERVE_USD=1
# Used only for direct Python launch; Compose maps generated passwords to these names.
APP_TOKEN=
ADMIN_TOKEN=
PORT=8000
DIGEST_TIMEZONE=Europe/Moscow
DIGEST_HOUR=19
TELEGRAM_TOKEN=
# Ask your bot /id, then add that private chat ID here. Comma-separated for friends.
TELEGRAM_CHAT_IDS=
